{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencoi:benchmark:prediction:v1",
  "title": "OpenCOI vendor-neutral text benchmark prediction v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "corpusSha256", "mode", "system", "cases"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "corpusId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "corpusSha256": { "$ref": "#/$defs/sha256" },
    "mode": { "const": "ZERO_TOUCH_TEXT_PARSE" },
    "system": { "$ref": "#/$defs/system" },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "version": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "pages": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    },
    "stringField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "evidencePages": { "$ref": "#/$defs/pages" }
      }
    },
    "numberField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "evidencePages": { "$ref": "#/$defs/pages" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageType"],
      "properties": {
        "coverageType": { "$ref": "#/$defs/stringField" },
        "insurerName": { "$ref": "#/$defs/stringField" },
        "policyNumber": { "$ref": "#/$defs/stringField" },
        "effectiveDate": { "$ref": "#/$defs/stringField" },
        "expirationDate": { "$ref": "#/$defs/stringField" },
        "limits": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/numberField" }
        }
      }
    },
    "endorsement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceLevel"],
      "properties": {
        "name": { "$ref": "#/$defs/stringField" },
        "formCode": { "$ref": "#/$defs/stringField" },
        "evidenceLevel": { "$ref": "#/$defs/stringField" }
      },
      "anyOf": [{ "required": ["name"] }, { "required": ["formCode"] }]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policies", "endorsements"],
      "properties": {
        "namedInsured": { "$ref": "#/$defs/stringField" },
        "certificateHolder": { "$ref": "#/$defs/stringField" },
        "policies": { "type": "array", "items": { "$ref": "#/$defs/policy" } },
        "endorsements": { "type": "array", "items": { "$ref": "#/$defs/endorsement" } }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "facts", "warningCodes"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "facts": { "$ref": "#/$defs/facts" },
        "warningCodes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "uniqueItems": true
        },
        "durationMs": { "type": "number", "minimum": 0 }
      }
    }
  }
}
