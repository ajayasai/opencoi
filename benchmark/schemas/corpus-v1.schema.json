{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencoi:benchmark:corpus:v1",
  "title": "OpenCOI vendor-neutral text benchmark corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "title", "license", "limitations", "cases"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "corpusId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "license": { "type": "string", "minLength": 1, "maxLength": 100 },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "pages": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    },
    "stringField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidencePages"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "evidencePages": { "$ref": "#/$defs/pages" }
      }
    },
    "numberField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidencePages"],
      "properties": {
        "value": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "evidencePages": { "$ref": "#/$defs/pages" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageType"],
      "properties": {
        "coverageType": { "$ref": "#/$defs/stringField" },
        "insurerName": { "$ref": "#/$defs/stringField" },
        "policyNumber": { "$ref": "#/$defs/stringField" },
        "effectiveDate": { "$ref": "#/$defs/stringField" },
        "expirationDate": { "$ref": "#/$defs/stringField" },
        "limits": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/numberField" }
        }
      }
    },
    "endorsement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceLevel"],
      "properties": {
        "name": { "$ref": "#/$defs/stringField" },
        "formCode": { "$ref": "#/$defs/stringField" },
        "evidenceLevel": { "$ref": "#/$defs/stringField" }
      },
      "anyOf": [{ "required": ["name"] }, { "required": ["formCode"] }]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policies", "endorsements"],
      "properties": {
        "namedInsured": { "$ref": "#/$defs/stringField" },
        "certificateHolder": { "$ref": "#/$defs/stringField" },
        "policies": { "type": "array", "items": { "$ref": "#/$defs/policy" } },
        "endorsements": { "type": "array", "items": { "$ref": "#/$defs/endorsement" } }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "strata", "pages", "truth", "warningCodes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "strata": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "text"],
            "properties": {
              "page": { "type": "integer", "minimum": 1 },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "truth": { "$ref": "#/$defs/facts" },
        "warningCodes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
