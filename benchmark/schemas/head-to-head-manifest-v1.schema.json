{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencoi:benchmark:head-to-head-manifest:v1",
  "title": "OpenCOI authorization-aware head-to-head manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "comparisonId",
    "title",
    "reportDate",
    "referenceSystemId",
    "methodology",
    "systems"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "comparisonId": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/name" },
    "reportDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "referenceSystemId": { "$ref": "#/$defs/id" },
    "methodology": { "$ref": "#/$defs/methodology" },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [{ "$ref": "#/$defs/providedSystem" }, { "$ref": "#/$defs/notTestedSystem" }]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "name": { "type": "string", "minLength": 1, "maxLength": 500 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rosterSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "limitations"],
      "properties": {
        "protocol": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessAuthorized",
        "publicationPermission",
        "attestedBy",
        "attestedAt",
        "basis"
      ],
      "properties": {
        "accessAuthorized": { "const": true },
        "publicationPermission": { "const": true },
        "attestedBy": { "$ref": "#/$defs/name" },
        "attestedAt": { "type": "string", "minLength": 1, "maxLength": 100 },
        "basis": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "sourceArtifact",
        "predictionArtifactSha256",
        "outputProducedAt",
        "runBy",
        "truthAccess",
        "normalizationMethod",
        "settings"
      ],
      "properties": {
        "sourceType": {
          "enum": [
            "FIRST_PARTY_RUN",
            "VENDOR_EXPORT",
            "AUTHORIZED_MANUAL_RUN",
            "AUTHORIZED_API_RUN"
          ]
        },
        "sourceArtifact": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "sourceArtifactSha256": { "$ref": "#/$defs/sha256" },
        "predictionArtifactSha256": { "$ref": "#/$defs/sha256" },
        "outputProducedAt": { "type": "string", "minLength": 1, "maxLength": 100 },
        "runBy": { "$ref": "#/$defs/name" },
        "truthAccess": { "enum": ["BLINDED", "NOT_BLINDED", "UNKNOWN"] },
        "normalizationMethod": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "settings": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 200 },
          "additionalProperties": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "providedSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "status", "predictionPath", "authorization", "provenance"],
      "properties": {
        "system": { "$ref": "#/$defs/rosterSystem" },
        "status": { "const": "PROVIDED" },
        "predictionPath": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "authorization": { "$ref": "#/$defs/authorization" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "notTestedSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "status", "reason"],
      "properties": {
        "system": { "$ref": "#/$defs/rosterSystem" },
        "status": { "const": "NOT_TESTED" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  }
}
