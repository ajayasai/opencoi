{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencoi:benchmark:score:v1",
  "title": "OpenCOI deterministic text benchmark score v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusId",
    "corpusSha256",
    "system",
    "mode",
    "facts",
    "macroF1",
    "fields",
    "citations",
    "warnings",
    "exactDocuments",
    "documentCount",
    "exactDocumentRate",
    "durationMs",
    "cases"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "corpusId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "corpusSha256": { "$ref": "#/$defs/sha256" },
    "system": { "$ref": "#/$defs/system" },
    "mode": { "const": "ZERO_TOUCH_TEXT_PARSE" },
    "facts": { "$ref": "#/$defs/metric" },
    "macroF1": { "$ref": "#/$defs/rate" },
    "fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldMetric" }
    },
    "citations": { "$ref": "#/$defs/citationMetric" },
    "warnings": { "$ref": "#/$defs/metric" },
    "exactDocuments": { "$ref": "#/$defs/count" },
    "documentCount": { "type": "integer", "minimum": 1 },
    "exactDocumentRate": { "$ref": "#/$defs/rate" },
    "durationMs": { "$ref": "#/$defs/duration" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/caseScore" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "version": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truePositive", "falsePositive", "falseNegative", "precision", "recall", "f1"],
      "properties": {
        "truePositive": { "$ref": "#/$defs/count" },
        "falsePositive": { "$ref": "#/$defs/count" },
        "falseNegative": { "$ref": "#/$defs/count" },
        "precision": { "$ref": "#/$defs/rate" },
        "recall": { "$ref": "#/$defs/rate" },
        "f1": { "$ref": "#/$defs/rate" }
      }
    },
    "fieldMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldType",
        "truePositive",
        "falsePositive",
        "falseNegative",
        "precision",
        "recall",
        "f1"
      ],
      "properties": {
        "fieldType": { "type": "string", "minLength": 1, "maxLength": 200 },
        "truePositive": { "$ref": "#/$defs/count" },
        "falsePositive": { "$ref": "#/$defs/count" },
        "falseNegative": { "$ref": "#/$defs/count" },
        "precision": { "$ref": "#/$defs/rate" },
        "recall": { "$ref": "#/$defs/rate" },
        "f1": { "$ref": "#/$defs/rate" }
      }
    },
    "citationMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "correct", "attempted", "truthWithEvidence", "precision", "recall"],
      "properties": {
        "coverage": { "$ref": "#/$defs/count" },
        "correct": { "$ref": "#/$defs/count" },
        "attempted": { "$ref": "#/$defs/count" },
        "truthWithEvidence": { "$ref": "#/$defs/count" },
        "precision": { "$ref": "#/$defs/rate" },
        "recall": { "$ref": "#/$defs/rate" }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportedCases", "median", "p95"],
      "properties": {
        "reportedCases": { "$ref": "#/$defs/count" },
        "median": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 }
      }
    },
    "caseScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "exactDocument", "facts", "citations", "warnings"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "exactDocument": { "type": "boolean" },
        "facts": { "$ref": "#/$defs/metric" },
        "citations": { "$ref": "#/$defs/citationMetric" },
        "warnings": { "$ref": "#/$defs/metric" }
      }
    }
  }
}
