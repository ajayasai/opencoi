{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencoi:benchmark:head-to-head-report:v1",
  "title": "OpenCOI authorization-aware head-to-head report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "comparisonId",
    "title",
    "reportDate",
    "corpus",
    "referenceSystemId",
    "methodology",
    "rows"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "comparisonId": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/name" },
    "reportDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "corpus": { "$ref": "#/$defs/corpus" },
    "referenceSystemId": { "$ref": "#/$defs/id" },
    "methodology": { "$ref": "#/$defs/methodology" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [{ "$ref": "#/$defs/testedRow" }, { "$ref": "#/$defs/notTestedRow" }]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "name": { "type": "string", "minLength": 1, "maxLength": 500 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "delta": { "type": "number", "minimum": -1, "maximum": 1 },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "sha256", "caseCount", "license"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/name" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "caseCount": { "type": "integer", "minimum": 1 },
        "license": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "scorer",
        "protocol",
        "rowOrder",
        "missingDataPolicy",
        "authorizationPolicy",
        "limitations"
      ],
      "properties": {
        "mode": { "const": "ZERO_TOUCH_TEXT_PARSE" },
        "scorer": { "const": "OpenCOI deterministic benchmark scorer 1.0" },
        "protocol": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "rowOrder": { "const": "SYSTEM_ID_ASCENDING_NOT_SCORE" },
        "missingDataPolicy": { "const": "NOT_TESTED_IS_NOT_ZERO" },
        "authorizationPolicy": { "const": "SELF_ATTESTATION_RECORDED_NOT_VERIFIED" },
        "limitations": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "rosterSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" }
      }
    },
    "testedSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "version": { "$ref": "#/$defs/id" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessAuthorized",
        "publicationPermission",
        "attestedBy",
        "attestedAt",
        "basis"
      ],
      "properties": {
        "accessAuthorized": { "const": true },
        "publicationPermission": { "const": true },
        "attestedBy": { "$ref": "#/$defs/name" },
        "attestedAt": { "type": "string", "minLength": 1, "maxLength": 100 },
        "basis": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "sourceArtifact",
        "predictionArtifactSha256",
        "outputProducedAt",
        "runBy",
        "truthAccess",
        "normalizationMethod",
        "settings",
        "normalizedPredictionSha256",
        "deterministicScoreSha256"
      ],
      "properties": {
        "sourceType": {
          "enum": [
            "FIRST_PARTY_RUN",
            "VENDOR_EXPORT",
            "AUTHORIZED_MANUAL_RUN",
            "AUTHORIZED_API_RUN"
          ]
        },
        "sourceArtifact": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "sourceArtifactSha256": { "$ref": "#/$defs/sha256" },
        "predictionArtifactSha256": { "$ref": "#/$defs/sha256" },
        "outputProducedAt": { "type": "string", "minLength": 1, "maxLength": 100 },
        "runBy": { "$ref": "#/$defs/name" },
        "truthAccess": { "enum": ["BLINDED", "NOT_BLINDED", "UNKNOWN"] },
        "normalizationMethod": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "settings": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 200 },
          "additionalProperties": { "type": "string", "maxLength": 2000 }
        },
        "normalizedPredictionSha256": { "$ref": "#/$defs/sha256" },
        "deterministicScoreSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "prf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "recall", "f1"],
      "properties": {
        "precision": { "$ref": "#/$defs/rate" },
        "recall": { "$ref": "#/$defs/rate" },
        "f1": { "$ref": "#/$defs/rate" }
      }
    },
    "citationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "recall"],
      "properties": {
        "precision": { "$ref": "#/$defs/rate" },
        "recall": { "$ref": "#/$defs/rate" }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportedCases", "median", "p95"],
      "properties": {
        "reportedCases": { "type": "integer", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "macroF1",
        "citations",
        "warnings",
        "exactDocuments",
        "documentCount",
        "exactDocumentRate",
        "durationMs"
      ],
      "properties": {
        "facts": { "$ref": "#/$defs/prf" },
        "macroF1": { "$ref": "#/$defs/rate" },
        "citations": { "$ref": "#/$defs/citationMetrics" },
        "warnings": { "$ref": "#/$defs/prf" },
        "exactDocuments": { "type": "integer", "minimum": 0 },
        "documentCount": { "type": "integer", "minimum": 1 },
        "exactDocumentRate": { "$ref": "#/$defs/rate" },
        "durationMs": { "$ref": "#/$defs/duration" }
      }
    },
    "deltas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macroF1", "factsF1", "citationRecall", "warningF1", "exactDocumentRate"],
      "properties": {
        "macroF1": { "$ref": "#/$defs/delta" },
        "factsF1": { "$ref": "#/$defs/delta" },
        "citationRecall": { "$ref": "#/$defs/delta" },
        "warningF1": { "$ref": "#/$defs/delta" },
        "exactDocumentRate": { "$ref": "#/$defs/delta" }
      }
    },
    "testedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "status",
        "authorizationEvidence",
        "authorization",
        "provenance",
        "score",
        "deltaFromReference"
      ],
      "properties": {
        "system": { "$ref": "#/$defs/testedSystem" },
        "status": { "const": "TESTED" },
        "authorizationEvidence": { "const": "SELF_ATTESTED_NOT_INDEPENDENTLY_VERIFIED" },
        "authorization": { "$ref": "#/$defs/authorization" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "score": { "$ref": "#/$defs/score" },
        "deltaFromReference": { "$ref": "#/$defs/deltas" }
      }
    },
    "notTestedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "status", "reason"],
      "properties": {
        "system": { "$ref": "#/$defs/rosterSystem" },
        "status": { "const": "NOT_TESTED" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  }
}
