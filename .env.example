# Runtime (NODE_ENV defaults to development locally; containers set production.)
HOST=127.0.0.1
PORT=4174
# Keep 0 for direct access. Set the exact controlled reverse-proxy hop count.
TRUST_PROXY_HOPS=0
APP_ORIGIN=http://localhost:5173
DATA_DIR=./data
DATABASE_PATH=./data/opencoi.sqlite
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# Bootstrap administrator (used only when the user table is empty)
BOOTSTRAP_ORG_NAME=Acme General Contractors
BOOTSTRAP_ORG_SLUG=acme-general-contractors
BOOTSTRAP_ADMIN_NAME=OpenCOI Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Sessions and public upload links
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=opencoi_session
UPLOAD_LINK_TTL_DAYS=14
# Add a stable random 32+ byte value in production. It keys token digests and
# encrypts webhook signing secrets; changing it invalidates tokens and makes existing
# webhook secrets unreadable.
TOKEN_PEPPER=
COOKIE_SECURE=false

# Optional OpenID Connect SSO. Configure all four required values together.
# The provider is bound to this one pre-existing OpenCOI organization.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ORGANIZATION_SLUG=
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OIDC_DISPLAY_NAME=Single sign-on
OIDC_TRANSACTION_TTL_MINUTES=10

# Email is optional. In-app reminder history still works without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OpenCOI <no-reply@example.com>

# Reminder worker
REMINDERS_ENABLED=true
REMINDER_POLL_MINUTES=360

# Optional external webhook worker (`docker compose --profile webhooks up -d`).
WEBHOOK_POLL_SECONDS=15
